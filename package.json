{
  "type": "module",
  "name": "starter",
  "version": "2026.10.01",
  "main": "server.ts",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .git-hooks || true",
    "biome:check": "biome check --error-on-warnings .",
    "biome:fix": "biome check --write --error-on-warnings .",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --outDir dist/server --ssr src/entry-server",
    "database:migrate": "tsx --env-file=.env scripts/database-migrate",
    "database:reset": "tsx --env-file=.env scripts/database-reset",
    "database:repl": "tsx --env-file=.env scripts/database-repl data/sqlite/database.sqlite",
    "dev": "tsx watch --include .env --env-file=.env server",
    "install:check": "vitest run tests/install",
    "make:clone": "tsx  --env-file=.env scripts/make-clone",
    "make:purge": "tsx --env-file=.env scripts/make-purge",
    "start": "tsx --env-file=.env server",
    "test": "vitest run --coverage --exclude tests/install",
    "types:check": "tsc --noEmit -p tsconfig.test.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pluralize": "^0.0.33",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "fs-extra": "^11.4.1",
    "jsdom": "^30.1.1",
    "pluralize": "^8.0.0",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  }
}
