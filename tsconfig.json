{
  "compilerOptions": {
    "noEmit": true,

    // Strictness
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    // Module
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,

    // JSX
    "jsx": "react-jsx",

    // Lib
    "target": "ES2024",

    // Types (framework scope only)
    "types": ["vite/client"]
  },
  "include": ["server.ts", "src/**/*"]
}
